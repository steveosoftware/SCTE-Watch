<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic — hand-built to exercise a full InLine linear ad (media
     files, click tracking, quartile events), not captured from a real ad
     server. Labeled per this project's fixture convention. -->
<VAST version="4.0">
  <Ad id="20001">
    <InLine>
      <AdSystem>ExampleAdServer</AdSystem>
      <AdTitle>Example Linear Ad</AdTitle>
      <Impression><![CDATA[https://track.example.com/impression?id=20001]]></Impression>
      <Creatives>
        <Creative>
          <Linear>
            <Duration>00:00:30</Duration>
            <TrackingEvents>
              <Tracking event="start"><![CDATA[https://track.example.com/start]]></Tracking>
              <Tracking event="firstQuartile"><![CDATA[https://track.example.com/q1]]></Tracking>
              <Tracking event="midpoint"><![CDATA[https://track.example.com/mid]]></Tracking>
              <Tracking event="complete"><![CDATA[https://track.example.com/complete]]></Tracking>
            </TrackingEvents>
            <VideoClicks>
              <ClickThrough><![CDATA[https://advertiser.example.com/landing]]></ClickThrough>
              <ClickTracking><![CDATA[https://track.example.com/click]]></ClickTracking>
            </VideoClicks>
            <MediaFiles>
              <MediaFile type="video/mp4" bitrate="2000" width="1280" height="720"><![CDATA[https://cdn.example.com/creative_1280x720.mp4]]></MediaFile>
              <MediaFile type="video/mp4" bitrate="800" width="640" height="360"><![CDATA[https://cdn.example.com/creative_640x360.mp4]]></MediaFile>
            </MediaFiles>
          </Linear>
        </Creative>
      </Creatives>
    </InLine>
  </Ad>
</VAST>
